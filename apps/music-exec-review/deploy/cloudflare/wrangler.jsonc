{
  // Deploy from this directory: npx wrangler deploy
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  "name": "fairplay",
  "main": "worker.mjs",
  "compatibility_date": "2025-07-01",
  "assets": {
    "directory": "../../public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "DB",
      // "fairplay-db" namespace, already created in the target Cloudflare account.
      "id": "89f7effc4455498e9d197d6ab177314d"
    }
  ]
}
